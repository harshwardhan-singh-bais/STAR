# ============================================================
# STAR — Environment Configuration Example
# Copy this file to .env and fill in your values
# ============================================================

# ── Gemini AI (Required for Copilot features) ─────────────
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Neo4j Graph Database (Optional) ───────────────────────
# If Neo4j is unavailable, the backend falls back to in-memory NetworkX
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
NEO4J_RETRY_ATTEMPTS=3
NEO4J_RETRY_BACKOFF=1.0

# ── Server Configuration ───────────────────────────────────
PORT=8000
HOST=0.0.0.0

# ── Risk Fusion Weights (Must sum to 1.0) ─────────────────
IF_WEIGHT=0.35
TGNN_WEIGHT=0.40
RULE_WEIGHT=0.25

# ── Risk Level Thresholds ─────────────────────────────────
RISK_ALERT_THRESHOLD=65.0
RISK_THRESHOLD_NORMAL=30.0
RISK_THRESHOLD_MONITORING=45.0
RISK_THRESHOLD_MODERATE=60.0
RISK_THRESHOLD_HIGH=75.0

# ── Streaming Configuration ─────────────────────────────────
STREAM_INTERVAL_MS=2000
MAX_STREAM_HISTORY=500
